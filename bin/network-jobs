#!/usr/bin/env bash
# network-jobs — local CLI: setup/doctor/import plus day-to-day search, companies, refresh.
set -euo pipefail

# Resolve our own path through symlinks: npm/pnpm .bin shims (and the
# ~/.local/bin launcher) are symlinks, and BASH_SOURCE[0] alone would point
# at the link's directory instead of the suite.
_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$_SOURCE" ]]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
ROOT="$(cd "$(dirname "$_SOURCE")/.." && pwd)"
unset _SOURCE _DIR
# shellcheck source=lib/agents.sh
source "$ROOT/lib/agents.sh"
# shellcheck source=lib/browser.sh
source "$ROOT/lib/browser.sh"

DATA_HOME="${NETWORK_JOBS_HOME:-$HOME/.network-jobs}"
export NETWORK_JOBS_SUITE="${NETWORK_JOBS_SUITE:-$ROOT}"

cmd="${1:-}"
shift || true

usage() {
  cat <<'EOF'
Usage: network-jobs [--help] <command> [options]

Commands:
  setup [--agent auto|all|name,...] [--force] [--copy] [--no-browser] [-v]
      Create ~/.network-jobs and install skills into agent skill dirs

  update [--agent auto|all|name,...] [--force] [--no-browser] [-v]
      Fetch latest suite, relink skills, install agent-browser if missing

  doctor
      Check tools, data dir, profile, skill links, corpus

  report [--title T] [--body B] [--label L] [--dry-run] [--yes]
      Assemble a sanitized diagnostic bundle and file a GitHub issue

  import <zip-or-csv> [--min-count N]
      Parse LinkedIn Connections into the local company graph

  search [--query "..."] [-k N] [--company-cap N] [--include-stale] [--json]
      Rank the corpus against your prefs and print matching jobs

  intros [--k-roles N] [--k-forwarders N] [--title T] [--url U] [--company C] [--prefer NAME]
      Pick 1-2 roles from the last search + 1-2 forwarders each
      from your connections (writes search/intros.json).
      Flags target reviewed roles instead of the search tail.

  companies [--sort connections|name|crawl] [--json]
      List the company graph: connections, last crawl, listing-set hash

  refresh [--company NAME] [--limit N] [--json]
      Re-crawl known listings endpoints (oldest first), stage new matches

  review-matches --triage-dir DIR [--min-cluster N] [--veto PHRASE] [--json]
      Cluster a match-prefs shortlist into job families; veto empirically

  build-pack <zip-or-csv> [--label NAME] [--out PATH]
      Build a publishable company-aggregated network pack (no names/emails)

  fetch-pack <url> [--as NAME]
      Download a published network pack into ~/.network-jobs/packs/

  demo [-k N] [--company-cap N]
      Rank a fixed synthetic job set (no network, no disk writes)

  embed-setup
      Install fastembed + warm the embedding model (one time); enables
      semantic resume<->job similarity in search/rank

  profile import <resume-file>
      Store resume under ~/.network-jobs/resume/ (feeds profile + interview)

  profile show
      Print profile, preferences, and resume status

  profile clear [--resume] [--yes]
      Reset profile + preferences (optional resume wipe); keeps corpus/graph

  corpus clear [--triage] [--yes]
      Empty the searchable corpus (keeps profile + connections); optional triage wipe

  reset [--agent auto|all|name,...] [--data] [--purge-cache] [--yes]
      Remove installed skill links (keeps ~/.network-jobs unless --data)

  uninstall [--agent auto|all|name,...] [--purge-cache] [--yes]
      Remove skill links + ~/.network-jobs (keeps the CLI itself installed)

  agents
      List supported agents and detection status

  routing
      Print the optional AGENTS.md / CLAUDE.md routing snippet

  which
      Print suite root and data home

  help [command]
      Show this help, or detailed help for one command

Global:
  -h, --help     Show this help
  -V, --version  Print package version

Env:
  NETWORK_JOBS_HOME        Data directory (default: ~/.network-jobs)
  NETWORK_JOBS_SKILLS_DIR  Install skills into this single parent only

Day-to-day searching also works from this CLI (search, companies, refresh);
deeper multi-step work happens in your agent.
EOF
}

usage_setup() {
  cat <<'EOF'
Usage: network-jobs setup [options]

Create ~/.network-jobs and link skills into one or more agent skill directories.
Installs agent-browser globally when missing (skip with --no-browser).

Options:
  --agent <list>    Target agents: auto (default), all, or claude-code,cursor,…
  --force           Replace existing non-symlink skill dirs (e.g. older installs)
  --copy            Copy skills instead of symlinking
  --no-browser      Skip installing agent-browser when missing
  --with-browser    Install agent-browser if missing (default)
  --print-routing   Print the AGENTS.md routing snippet when finished
  --verbose, -v     Show every path as it is linked
  --help, -h        Show this help

Env:
  NETWORK_JOBS_HOME        Data directory (default: ~/.network-jobs)
  NETWORK_JOBS_SKILLS_DIR  Single skills parent (overrides --agent)
EOF
}

usage_update() {
  cat <<'EOF'
Usage: network-jobs update [options]

Refresh the suite to the latest release, rewrite skill symlinks, and ensure
agent-browser is installed.

When this CLI was installed via npm -g, update runs:
  npm i -g @hirefrank/network-jobs@latest
then re-runs local setup.

When this CLI was installed via npx, update clears the cached package copy
and re-runs: npx --yes @hirefrank/network-jobs@latest setup …

When run from a local git checkout, update pulls (if possible) and re-runs
local setup against that tree.

Options (passed through to setup):
  --agent <list>   Target agents: auto (default), all, or claude-code,cursor,…
  --force          Replace existing non-symlink skill dirs
  --no-browser     Skip installing agent-browser
  --verbose, -v    Show every path as it is linked
  --help, -h       Show this help

Examples:
  network-jobs update
  npm i -g @hirefrank/network-jobs@latest && network-jobs setup --agent auto --force
EOF
}

usage_doctor() {
  cat <<'EOF'
Usage: network-jobs doctor

Check required tools, the data directory, profile completeness, skill links,
and corpus status. Exit 0 when healthy, 1 when issues are found.

Options:
  --help, -h   Show this help
EOF
}

usage_report() {
  cat <<'EOF'
Usage: network-jobs report [options]

Assemble a sanitized diagnostic bundle (versions, doctor output, data
counts, preferences/profile key names only, latest import summary, one
triage INVENTORY) and file it as a GitHub issue. Values that identify
you — profile fields, resume text, connection rows — are never included;
key names only. Review the exact body with --dry-run first.

Options:
  --title TEXT   Issue title (default: "network-jobs diagnostic bundle")
  --body TEXT    Your description (or --stdin to read it)
  --stdin        Read the description from stdin
  --label NAME   Issue label (default: bug)
  --repo SLUG    Target repo (default: hirefrank/network-jobs)
  --triage-dir D Focus the bundle on one triage batch (default: most recent)
  --dry-run      Print the exact issue body and file nothing
  --yes, -y      Skip confirmation (non-interactive use)
  --help, -h     Show this help

Examples:
  network-jobs report --title "Greenhouse listings came back without urls" --dry-run
  echo "steps to reproduce…" | network-jobs report --title "…" --stdin --yes
EOF
}

usage_import() {
  cat <<'EOF'
Usage: network-jobs import <zip-or-csv> [--min-count N]

Parse a LinkedIn Connections export (ZIP or Connections.csv) into:
  ~/.network-jobs/connections/connections.json
  ~/.network-jobs/companies/companies.json

Options:
  --min-count N   Only keep companies with at least N connections (default: 1)
  --help, -h      Show this help

Examples:
  network-jobs import ~/Downloads/Connections.zip
  network-jobs import ./fixtures/Connections.csv --min-count 2
EOF
}

usage_search() {
  cat <<'EOF'
Usage: network-jobs search [--query "..."] [-k N] [--include-stale] [--json] [-v]

Rank the corpus against preferences.json (+ resume keywords) and print the
top matches. Also writes ~/.network-jobs/search/ranked.json for follow-on
steps like rank-intros.

Options:
  --query "..."    Boost jobs matching these terms (also narrows shards)
  -k N            Show the top N matches (default: 25)
  --company-cap N Max jobs per company in the shortlist (default: 3, 0 = no cap)
  --include-stale Also show stale postings (posted >90d ago, hidden by default)
  --json          Print the ranked.json payload instead of a human list
  -v, --verbose   Append a fit brief per role (reasons, resume hits,
                  connection warmth, gaps). Default output is unchanged.
  --help, -h      Show this help

Examples:
  network-jobs search
  network-jobs search --query "staff product engineer" -k 10
EOF
}

usage_intros() {
  cat <<'EOF'
Usage: network-jobs intros [--k-roles N] [--k-forwarders N] [--title T] [--url U] [--company C] [--prefer NAME]

Pick up to N roles from the last `network-jobs search` (search/ranked.json)
and up to N forwarders per role from your connections. Writes
~/.network-jobs/search/intros.json for the intro-email-generator skill.

Forwarder order measures title overlap only — never relationship strength.
Ask who the user actually knows well and pin them with --prefer.

Options:
  --k-roles N       Max roles to keep (default: 2)
  --k-forwarders N  Max forwarders per role (default: 2)
  --title TEXT      Only roles whose title contains this text
  --url TEXT        Only roles whose url contains this text
  --company NAME    Only roles at this company (normalized match)
  --prefer NAME     Pin a person to the top of forwarders by name (repeatable)
  --help, -h        Show this help

With --title/--url/--company, intros targets reviewed roles instead of the
top of the last search. No match is an error.

Examples:
  network-jobs intros
  network-jobs intros --title "Staff PM" --company Stripe
  network-jobs intros --k-roles 1 --k-forwarders 3
EOF
}

usage_build_pack() {
  cat <<'EOF'
Usage: network-jobs build-pack <zip-or-csv> [--label NAME] [--out PATH] [--min-count N]

Build a publishable company-aggregated network pack from a LinkedIn export:
company names, connection counts, title keywords — no names, emails, URLs,
or dates. Share the file; others fetch it with fetch-pack.

Options:
  --label NAME   Pack owner label, e.g. 'Frank Harris'
  --out PATH     Output JSON path (default: <label>-network-pack-<date>.json)
  --min-count N  Drop companies with fewer connections (default: 1)
  --help, -h     Show this help

Examples:
  network-jobs build-pack ~/Downloads/Connections.zip --label "Frank Harris"
EOF
}

usage_fetch_pack() {
  cat <<'EOF'
Usage: network-jobs fetch-pack <url> [--as NAME]

Download a published network pack into ~/.network-jobs/packs/. Validates
the pack shape before saving. Packs are read-only overlays for search
cross-referencing — they never merge into your connections or affect
scoring. The suite's one sanctioned remote fetch.

Options:
  --as NAME    Pack name (default: slug of the pack label)
  --help, -h   Show this help

Examples:
  network-jobs fetch-pack https://hirefrank.com/network-pack.json
EOF
}

usage_review_matches() {
  cat <<'EOF'
Usage: network-jobs review-matches --triage-dir DIR [options]
Cluster a match-prefs shortlist into job families (category + title stem)
so deal-breakers are set empirically against observed counts — not guessed
in advance. Also reports near-miss leaks grouped by the rule that caught
them. Read-only unless --veto is given.

Options:
  --triage-dir DIR   Triage batch directory (required)
  --min-cluster N    Families below N members fold into one bucket (default: 2)
  --veto PHRASE      Add a deal-breaker phrase, rewrite preferences.json
                     (marks dealBreakersConfirmed), re-run match-prefs and
                     print before/after counts (repeatable)
  --json             Machine-readable output instead of text
  --help, -h         Show this help

Examples:
  network-jobs review-matches --triage-dir ~/.network-jobs/triage/careers-stripe-2026-09-29
  network-jobs review-matches --triage-dir … --veto "data center" --veto architect
EOF
}

usage_demo() {
  cat <<'EOF'
Usage: network-jobs demo [-k N] [--company-cap N]
Rank a fixed set of synthetic jobs (fake companies, no PII) against your
preferences.json — or engineering/product defaults when none is set. No
network, no disk writes: a quick end-to-end check of the scoring pipeline.

Options:
  -k N            Show the top N demo jobs (default: 8)
  --company-cap N Max jobs per company in the shortlist (default: 3, 0 = no cap)
  --help, -h      Show this help

Examples:
  network-jobs demo
  network-jobs demo --company-cap 0
EOF
}

usage_embed_setup() {
  cat <<'EOF'
Usage: network-jobs embed-setup

Install fastembed and download the embedding model (one time, ~60MB), then
warm the model and refresh corpus embeddings. Enables the resume-semantic
and query-semantic signals in search/rank. Keyword scoring is unchanged
when embeddings are not installed.

  --help, -h      Show this help
EOF
}

usage_companies() {
  cat <<'EOF'
Usage: network-jobs companies [--sort connections|name|crawl] [--json]

List the company graph: connection counts, last crawl time, listing-set hash,
and whether a listings endpoint is stored (jobsUrl, needed for refresh).

Options:
  --sort KEY   connections (default), name, or crawl
  --json       Print companies.json rows instead of a table
  --help, -h   Show this help
EOF
}

usage_refresh() {
  cat <<'EOF'
Usage: network-jobs refresh [--company NAME] [--limit N] [--json]

Re-crawl the listings JSON endpoints stored on the company graph (stamped by
crawl-state --stamp --source-url during careers-discover), oldest crawl first.
Changed boards are re-scored against your prefs and staged under
~/.network-jobs/triage/careers-<slug>-<today>/; unchanged boards just get
their lastCrawl stamped. Fully deterministic — no model in the loop.

Options:
  --company NAME Only refresh this company (name or slug)
  --limit N      Max companies per run (default: 5, oldest crawl first)
  --json         Print a machine-readable summary
  --help, -h     Show this help

Examples:
  network-jobs refresh
  network-jobs refresh --company stripe --limit 1
EOF
}

usage_profile() {
  cat <<'EOF'
Usage: network-jobs profile import <resume-file>
       network-jobs profile show
       network-jobs profile clear [--resume] [--yes]

import  Copy a resume into ~/.network-jobs/resume/, extract text when possible
        (txt/md, pdf via pdftotext, docx via python). Does not overwrite
        profile.json by itself — ask your agent to fill profile from the resume,
        then run the preferences interview (location, remote/hybrid/onsite, …).

show    Print profile.json, preferences.json, and resume file status.

clear   Reset identity prefs: empty profile.json and delete preferences.json.
        Does **not** touch corpus, connections, or companies.
        Pass --resume to also delete ~/.network-jobs/resume/.

Options:
  --resume     Also remove stored resume files (with clear)
  --yes, -y    Skip confirmation (clear only)
  --help, -h   Show this help

Examples:
  network-jobs profile import ~/Downloads/Resume.pdf
  network-jobs profile show
  network-jobs profile clear --yes
  network-jobs profile clear --resume --yes
EOF
}

usage_corpus() {
  cat <<'EOF'
Usage: network-jobs corpus clear [--triage] [--yes]
Empty the searchable job corpus under ~/.network-jobs/corpus/ while keeping
profile, connections, companies, config, preferences, and resume.

Options:
  --triage     Also delete staged careers-* folders under triage/
  --yes, -y    Skip confirmation
  --help, -h   Show this help

Resets corpus/manifest.json to totalJobs=0 and removes jobs-all.json plus
category / granular shard files. Does not uninstall skills.

Examples:
  network-jobs corpus clear --yes
  network-jobs corpus clear --triage --yes
EOF
}

usage_reset() {
  cat <<'EOF'
Usage: network-jobs reset [options]
       network-jobs uninstall [options]

Remove installed skill links from agent skill directories.

The npm package and the ~/.local/bin launcher stay installed. When a reset
finishes, the two commands that remove them are printed — they are never run
for you, because a CLI cannot safely uninstall the package it is running from.

Options:
  --agent <list>   Target agents: auto (default), all, or claude-code,cursor,…
  --data           Also delete ~/.network-jobs (connections, corpus, profile)
  --purge-cache    Also clear cached npx/pnpm copies of this suite
  --yes, -y        Skip confirmation
  --help, -h       Show this help

uninstall is an alias for reset --data.

Examples:
  network-jobs reset --yes
  network-jobs uninstall --yes --purge-cache
  network-jobs setup --agent auto
EOF
}

usage_agents() {
  cat <<'EOF'
Usage: network-jobs agents

List supported agents, their skill directories, and whether each was detected
on this machine (tab-separated: name, path, status).

Options:
  --help, -h   Show this help
EOF
}

usage_routing() {
  cat <<'EOF'
Usage: network-jobs routing

Print the optional AGENTS.md / CLAUDE.md routing snippet. Skills already
self-describe via frontmatter; this is only if you want the workflow pinned
in a project's instructions.

Options:
  --help, -h   Show this help
EOF
}

usage_which() {
  cat <<'EOF'
Usage: network-jobs which

Print the suite root and data home paths.

Options:
  --help, -h   Show this help
EOF
}

cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    "" ) usage ;;
    setup) usage_setup ;;
    update) usage_update ;;
    doctor) usage_doctor ;;
    report) usage_report ;;
    import) usage_import ;;
    search) usage_search ;;
    intros) usage_intros ;;
    demo) usage_demo ;;
    embed-setup) usage_embed_setup ;;
    companies) usage_companies ;;
    refresh) usage_refresh ;;
    review-matches) usage_review_matches ;;
    build-pack) usage_build_pack ;;
    fetch-pack) usage_fetch_pack ;;
    profile) usage_profile ;;
    corpus) usage_corpus ;;
    reset|uninstall) usage_reset ;;
    agents) usage_agents ;;
    routing) usage_routing ;;
    which) usage_which ;;
    help)
      cat <<'EOF'
Usage: network-jobs help [command]

Show top-level help, or detailed help for one command.
EOF
      ;;
    *)
      echo "Unknown command: $topic" >&2
      echo "Try: network-jobs --help" >&2
      return 1
      ;;
  esac
}

network_jobs_want_help() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      -h|--help|help) return 0 ;;
    esac
  done
  return 1
}

network_jobs_version() {
  local pkg="$ROOT/package.json"
  if [[ -f "$pkg" ]] && command -v jq >/dev/null 2>&1; then
    jq -r '"network-jobs " + (.version // "0.0.0")' "$pkg"
  else
    echo "network-jobs"
  fi
}

network_jobs_resolve_agents() {
  local csv="${1:-auto}"
  local -a names=()
  local name
  case "$csv" in
    all) names=("${NETWORK_JOBS_AGENT_IDS[@]}") ;;
    auto)
      while IFS= read -r name; do
        [[ -n "$name" ]] && names+=("$name")
      done < <(network_jobs_detect_agents)
      ;;
    *)
      IFS=',' read -ra names <<<"$csv"
      ;;
  esac
  for name in "${names[@]}"; do
    name="$(echo "$name" | xargs)"
    [[ -n "$name" ]] && printf '%s\n' "$name"
  done
}

cmd_reset() {
  local agents_csv="auto"
  local wipe_data=0
  local yes=0
  local purge_cache=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent|--agents) agents_csv="$2"; shift 2 ;;
      --data|--wipe-data) wipe_data=1; shift ;;
      --purge-cache) purge_cache=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -h|--help) usage_reset; return 0 ;;
      *)
        echo "Unknown arg: $1" >&2
        echo "Try: network-jobs reset --help" >&2
        return 1
        ;;
    esac
  done

  local -a agent_names=()
  local name dir skill dest
  while IFS= read -r name; do
    [[ -n "$name" ]] && agent_names+=("$name")
  done < <(network_jobs_resolve_agents "$agents_csv")

  if ((${#agent_names[@]} == 0)); then
    echo "error: no agents selected" >&2
    return 1
  fi

  echo "This will remove:"
  for name in "${agent_names[@]}"; do
    dir="$(network_jobs_agent_dir "$name" || true)"
    [[ -z "$dir" ]] && continue
    echo "  skills in $dir ($name)"
  done
  if [[ "$wipe_data" -eq 1 ]]; then
    echo "  data dir $DATA_HOME"
  else
    echo "  (keeping data dir $DATA_HOME — pass --data to wipe)"
  fi
  if [[ "$purge_cache" -eq 1 ]]; then
    echo "  cached npx/pnpm copies of @hirefrank/network-jobs"
  fi
  echo

  if [[ "$yes" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      echo "error: non-interactive shell — pass --yes to confirm" >&2
      return 1
    fi
    printf "Continue? [y/N] "
    local answer
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; return 1 ;;
    esac
  fi

  local removed=0 skipped=0
  for name in "${agent_names[@]}"; do
    dir="$(network_jobs_agent_dir "$name" || true)"
    if [[ -z "$dir" ]]; then
      echo "warning: unknown agent '$name' — skipped" >&2
      continue
    fi
    for skill in "${NETWORK_JOBS_SKILL_IDS[@]}"; do
      dest="$dir/$skill"
      if [[ -L "$dest" || -e "$dest" ]]; then
        rm -rf "$dest"
        echo "removed $dest"
        removed=$((removed + 1))
      else
        skipped=$((skipped + 1))
      fi
    done
  done

  if [[ "$wipe_data" -eq 1 ]]; then
    if [[ -e "$DATA_HOME" || -L "$DATA_HOME" ]]; then
      rm -rf "$DATA_HOME"
      echo "removed $DATA_HOME"
    else
      echo "no data dir at $DATA_HOME"
    fi
  fi

  if [[ "$purge_cache" -eq 1 ]]; then
    network_jobs_purge_package_cache
  fi

  echo
  echo "Reset complete ($removed removed)."
  if [[ "$wipe_data" -eq 1 ]]; then
    echo "Reinstall: npm i -g @hirefrank/network-jobs@latest && network-jobs setup --agent auto"
  else
    echo "Re-link skills: network-jobs setup --agent auto"
  fi
  print_cli_removal_hint "$purge_cache"
}

# Print — never run — the steps that remove the CLI itself.
#
# reset owns skill links and the data dir only. The npm package and the
# ~/.local/bin launcher survive it, and the launcher falls back to
# `npx …@latest`, so leaving it in place means the next invocation silently
# re-fetches the suite. A CLI also cannot reliably uninstall the package it is
# executing from (npm may be a version-manager shim, and the prefix is unknown),
# so the honest thing is to hand the user the exact commands.
print_cli_removal_hint() {
  local purge_cache="${1:-0}"
  local launcher="$HOME/.local/bin/network-jobs"

  echo
  echo "The CLI itself is still installed — reset removes skill links and data, not the command."
  echo "To remove it:"
  if [[ "$purge_cache" -ne 1 ]]; then
    echo "  network-jobs reset --yes --purge-cache    # clear cached npx/pnpm copies first"
  fi
  if network_jobs_is_npm_global_install "$ROOT"; then
    if command -v npm >/dev/null 2>&1 && npm --version >/dev/null 2>&1; then
      echo "  npm uninstall -g @hirefrank/network-jobs"
    else
      # npm is often a version-manager shim that fails with no global runtime
      # selected; say so rather than printing a command that will not resolve.
      echo "  npm uninstall -g @hirefrank/network-jobs    # after fixing npm on PATH"
    fi
  elif network_jobs_is_packaged_install "$ROOT"; then
    echo "  # this copy is not an npm-global install — nothing global to remove"
  else
    echo "  # running from a source checkout — delete the clone when you are done"
  fi
  if [[ -e "$launcher" || -L "$launcher" ]]; then
    echo "  rm -f $launcher"
  fi
}

cmd_update() {
  if network_jobs_want_help "$@"; then
    usage_update
    return 0
  fi

  local -a setup_args=("$@")
  # Always force-replace stale non-symlink skill dirs on update unless user set --copy
  local has_force=0 has_copy=0
  local arg
  for arg in "${setup_args[@]+"${setup_args[@]}"}"; do
    case "$arg" in
      --force) has_force=1 ;;
      --copy) has_copy=1 ;;
    esac
  done
  if [[ "$has_force" -eq 0 && "$has_copy" -eq 0 ]]; then
    setup_args+=(--force)
  fi

  if network_jobs_is_packaged_install "$ROOT"; then
    if network_jobs_is_npm_global_install "$ROOT"; then
      echo "Updating npm-global install (@hirefrank/network-jobs)…"
      if command -v npm >/dev/null 2>&1 && npm i -g '@hirefrank/network-jobs@latest'; then
        echo "Re-running setup…"
        exec "$ROOT/setup" "${setup_args[@]}"
      fi
      echo "error: npm update failed — run: npm i -g @hirefrank/network-jobs@latest" >&2
      return 1
    fi
    echo "Updating from GitHub (purging cached suite first)…"
    network_jobs_purge_package_cache
    local runner
    if ! runner="$(network_jobs_package_runner)"; then
      echo "error: neither pnpm nor npx is usable — cannot re-fetch the suite" >&2
      return 1
    fi
    # Fresh process so the runner resolves a new store path for @latest
    # shellcheck disable=SC2086
    exec $runner '@hirefrank/network-jobs@latest' setup "${setup_args[@]}"
  fi

  if [[ -d "$ROOT/.git" ]]; then
    echo "Updating local checkout at $ROOT …"
    if command -v git >/dev/null 2>&1; then
      if git -C "$ROOT" diff --quiet && git -C "$ROOT" diff --cached --quiet; then
        git -C "$ROOT" pull --ff-only || echo "warning: git pull failed — continuing with local tree" >&2
      else
        echo "warning: uncommitted local changes — skipping git pull"
      fi
    fi
  else
    echo "Re-linking from $ROOT …"
  fi
  exec "$ROOT/setup" "${setup_args[@]}"
}

cmd_doctor() {
  if network_jobs_want_help "$@"; then
    usage_doctor
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    echo "Try: network-jobs doctor --help" >&2
    return 1
  fi

  local ok=1
  echo "==> Network Jobs doctor"
  echo "    Suite: $ROOT"
  echo "    Data:  $DATA_HOME"
  if [[ -f "$DATA_HOME/version" ]]; then
    echo "    Version: $(cat "$DATA_HOME/version")"
  fi
  echo

  for tool in curl jq unzip python3; do
    if command -v "$tool" >/dev/null 2>&1; then
      echo "OK  $tool"
    else
      echo "MISS $tool"
      ok=0
    fi
  done
  if command -v agent-browser >/dev/null 2>&1; then
    local ab_have ab_min ab_spec ab_desc
    ab_have="$(ab_installed_version || true)"
    ab_min="$(ab_min_version "$ROOT/package.json" || true)"
    if [[ -n "$ab_min" ]]; then
      ab_spec="agent-browser@${ab_min}"
    else
      ab_spec="agent-browser"
    fi
    ab_desc="$(ab_describe_version "$ab_have" "$ab_min")"
    if [[ "$ab_desc" == *" < "* ]]; then
      echo "WARN agent-browser $ab_desc — network-jobs update   (or: npm i -g $ab_spec)"
    else
      echo "OK  agent-browser ${ab_desc}"
    fi
  elif [[ -f "$DATA_HOME/config/no-browser" ]]; then
    echo "OK  agent-browser skipped (setup --no-browser)"
  else
    local ab_min ab_spec
    ab_min="$(ab_min_version "$ROOT/package.json" || true)"
    if [[ -n "$ab_min" ]]; then
      ab_spec="agent-browser@${ab_min}"
    else
      ab_spec="agent-browser"
    fi
    echo "WARN agent-browser missing — network-jobs update   (or: npm i -g $ab_spec)"
  fi
  if command -v network-jobs >/dev/null 2>&1; then
    echo "OK  network-jobs on PATH ($(command -v network-jobs))"
  else
    echo "WARN network-jobs not on PATH — run setup again, or add ~/.local/bin to PATH"
  fi
  echo

  for p in connections companies config triage corpus logs; do
    if [[ -d "$DATA_HOME/$p" ]]; then
      echo "OK  $DATA_HOME/$p"
    else
      echo "MISS $DATA_HOME/$p — run: network-jobs setup"
      ok=0
    fi
  done

  if [[ -f "$DATA_HOME/profile.json" ]]; then
    local name email
    name="$(jq -r '.name // empty' "$DATA_HOME/profile.json" 2>/dev/null || true)"
    email="$(jq -r '.email // empty' "$DATA_HOME/profile.json" 2>/dev/null || true)"
    if [[ -n "$name" && -n "$email" ]]; then
      echo "OK  profile ($name / $email)"
    else
      echo "WARN profile.json incomplete (name/email) — profile import + agent setup"
    fi
  else
    echo "MISS profile.json"
    ok=0
  fi

  if [[ -f "$DATA_HOME/preferences.json" ]]; then
    local prefs_done
    prefs_done="$(jq -r '.interviewComplete // false' "$DATA_HOME/preferences.json" 2>/dev/null || echo false)"
    if [[ "$prefs_done" == "true" ]]; then
      echo "OK  preferences (interview complete)"
    else
      echo "WARN preferences.json present but interviewComplete!=true — finish prefs in agent"
    fi
  else
    echo "WARN no preferences.json — in your agent: job search preferences interview"
  fi

  if [[ -f "$DATA_HOME/resume/text.md" ]] || compgen -G "$DATA_HOME/resume/source.*" >/dev/null 2>&1; then
    echo "OK  resume under $DATA_HOME/resume"
  else
    echo "TIP  no resume yet — network-jobs profile import ~/path/to/resume.pdf"
  fi

  if [[ -f "$DATA_HOME/companies/companies.json" ]]; then
    echo "OK  companies ($(jq 'length' "$DATA_HOME/companies/companies.json") entries)"
  else
    echo "WARN no companies.json — network-jobs import <zip-or-csv>"
  fi

  if [[ -f "$DATA_HOME/corpus/manifest.json" ]]; then
    local total
    total="$(jq -r '.totalJobs // 0' "$DATA_HOME/corpus/manifest.json")"
    echo "OK  corpus totalJobs=$total"
    if [[ "$total" == "0" || "$total" == "null" ]]; then
      echo "TIP  corpus empty — in your agent: find open roles… then confirm before ingest"
    fi
  fi

  # Embeddings (round 5): provider + cache coverage from the Python CLI.
  echo
  local _emb_json
  _emb_json="$(PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" python3 -m network_jobs.cli doctor --json 2>/dev/null)" || _emb_json=""
  if [[ -n "$_emb_json" ]]; then
    printf '%s' "$_emb_json" | jq -r '
      (if .provider then "embeddings: \(.provider) (\(.model), \(.dims)d)"
       else "embeddings: not configured (keyword scoring only)\n  run `network-jobs embed-setup` to enable semantic matching" end),
      (if .embeddingsFile then "cache: \(.vectorsCached) vectors, model=\(.cacheModel), coverage \((.coverage * 100 | round))% of \(.corpusJobs) corpus jobs"
       else "cache: none (run rebuild or refresh with a provider configured)" end)'
  else
    echo "embeddings: status unavailable"
  fi

  echo
  echo "==> Skill links"
  local a_name a_dir a_hint skill linked
  while IFS= read -r line; do
    IFS=$'\t' read -r a_name a_dir a_hint <<<"$line"
    [[ -z "$a_hint" ]] && continue
    linked=0
    for skill in "${NETWORK_JOBS_SKILL_IDS[@]}"; do
      if [[ -e "$a_dir/$skill/SKILL.md" ]]; then
        linked=$((linked + 1))
      fi
    done
    echo "$a_name: $linked/${#NETWORK_JOBS_SKILL_IDS[@]} skills in $a_dir"
  done < <(network_jobs_list_agents)

  echo
  if [[ "$ok" -eq 1 ]]; then
    echo "Doctor: OK"
    return 0
  fi
  echo "Doctor: issues found"
  return 1
}

cmd_report() {
  local title="" body="" label="bug" repo="hirefrank/network-jobs"
  local triage_sel="" dry_run=0 yes=0 use_stdin=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title) title="$2"; shift 2 ;;
      --body) body="$2"; shift 2 ;;
      --stdin) use_stdin=1; shift ;;
      --label) label="$2"; shift 2 ;;
      --repo) repo="$2"; shift 2 ;;
      --triage-dir) triage_sel="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -h|--help) usage_report; return 0 ;;
      *)
        echo "Unknown arg: $1" >&2
        echo "Try: network-jobs report --help" >&2
        return 1
        ;;
    esac
  done

  if [[ "$use_stdin" -eq 1 ]]; then
    body="$(cat)"
  fi
  [[ -n "$title" ]] || title="network-jobs diagnostic bundle"

  if ! command -v jq >/dev/null 2>&1; then
    echo "error: report needs jq (doctor dependency)" >&2
    return 1
  fi

  local tmp
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN

  {
    echo "## Environment"
    echo
    echo "- $(network_jobs_version)"
    if [[ -d "$ROOT/.git" ]] && command -v git >/dev/null 2>&1; then
      echo "- suite commit: $(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    else
      echo "- suite: ${ROOT/#$HOME/\~} (not a git checkout)"
    fi
    for tool in node python3 gh; do
      if command -v "$tool" >/dev/null 2>&1; then
        echo "- $tool: $("$tool" --version 2>/dev/null | head -n1 || echo present)"
      else
        echo "- $tool: MISSING"
      fi
    done
    echo "- data: ${DATA_HOME/#$HOME/\~}"
    if [[ "${NETWORK_JOBS_HOME:-}" != "" && "$DATA_HOME" != "$HOME/.network-jobs" ]]; then
      echo "- NETWORK_JOBS_HOME overridden"
    fi
    echo
    echo "## Doctor"
    echo
    echo '```'
    # Sanitize: doctor prints the profile identity line and absolute home
    # paths. Neither belongs in a public bundle.
    cmd_doctor 2>&1 \
      | sed -E "s|${HOME}|~|g; s/^(OK  profile \().*\)$/\1<name \/ email redacted>)/" || true
    echo '```'
    echo
    echo "## Data snapshot (counts and key names only — no values)"
    echo
    local nconn="n/a" ncomp="n/a" tjobs="n/a"
    [[ -f "$DATA_HOME/connections/connections.json" ]] \
      && nconn="$(jq 'length' "$DATA_HOME/connections/connections.json" 2>/dev/null || echo n/a)"
    [[ -f "$DATA_HOME/companies/companies.json" ]] \
      && ncomp="$(jq 'length' "$DATA_HOME/companies/companies.json" 2>/dev/null || echo n/a)"
    [[ -f "$DATA_HOME/corpus/manifest.json" ]] \
      && tjobs="$(jq -r '.totalJobs // "n/a"' "$DATA_HOME/corpus/manifest.json" 2>/dev/null || echo n/a)"
    echo "- connections: $nconn, companies: $ncomp, corpus totalJobs: $tjobs"
    local batches=""
    if [[ -d "$DATA_HOME/triage" ]]; then
      batches="$(ls -1 "$DATA_HOME/triage" 2>/dev/null | grep '^careers-' | tr '\n' ' ' || true)"
    fi
    echo "- triage batches: ${batches:-none}"
    if [[ -f "$DATA_HOME/preferences.json" ]]; then
      echo "- preferences keys: $(jq -c 'keys' "$DATA_HOME/preferences.json" 2>/dev/null || echo n/a)"
    else
      echo "- preferences.json: missing"
    fi
    if [[ -f "$DATA_HOME/profile.json" ]]; then
      echo "- profile keys: $(jq -c 'keys' "$DATA_HOME/profile.json" 2>/dev/null || echo n/a)"
    else
      echo "- profile.json: missing"
    fi
    if compgen -G "$DATA_HOME/resume/source.*" >/dev/null 2>&1; then
      echo "- resume: present ($(ls "$DATA_HOME"/resume/source.* 2>/dev/null | wc -l) file(s), names withheld)"
    else
      echo "- resume: none"
    fi
    echo
    echo "## Latest import summary"
    echo
    local latest_log=""
    latest_log="$(ls -t "$DATA_HOME"/logs/import-*.json 2>/dev/null | head -n1 || true)"
    if [[ -n "$latest_log" ]]; then
      jq -r '"- \(.timestamp): \(.keptConnections) kept (\(.ignoredConnections) ignored), \(.companies) companies" | .,
               "- top: " + ([.topCompanies[]? | "\(.name) (\(.count))"] | join(", "))' \
        "$latest_log" 2>/dev/null || echo "- (unreadable log)"
    else
      echo "- no import logs yet"
    fi
    echo
    echo "## Triage INVENTORY"
    echo
    local batch_dir=""
    if [[ -n "$triage_sel" ]]; then
      batch_dir="$triage_sel"
    else
      batch_dir="$(ls -dt "$DATA_HOME"/triage/careers-* 2>/dev/null | head -n1 || true)"
    fi
    if [[ -n "$batch_dir" && -f "$batch_dir/INVENTORY.md" ]]; then
      echo "Batch: \`$(basename "$batch_dir")\`"
      echo
      head -n 120 "$batch_dir/INVENTORY.md"
    else
      echo "- no triage INVENTORY found"
    fi
    echo
    echo "## User report"
    echo
    if [[ -n "$body" ]]; then
      echo "$body"
    else
      echo "(no description provided)"
    fi
  } > "$tmp"

  if [[ "$dry_run" -eq 1 ]]; then
    cat "$tmp"
    return 0
  fi

  if ! command -v gh >/dev/null 2>&1; then
    echo "error: gh is not installed — file manually with: network-jobs report --dry-run" >&2
    return 1
  fi

  if [[ "$yes" -ne 1 ]]; then
    echo "Issue title: $title"
    echo "Bundle: $(wc -l < "$tmp") lines (preview everything with --dry-run)"
    echo "Target: $repo (label: $label)"
    echo
    if [[ ! -t 0 ]]; then
      echo "error: non-interactive shell — pass --yes to confirm" >&2
      return 1
    fi
    printf "File this issue? [y/N] "
    local answer
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; return 1 ;;
    esac
  fi

  if [[ -n "$label" ]]; then
    gh issue create --repo "$repo" --title "$title" --body-file "$tmp" --label "$label"
  else
    gh issue create --repo "$repo" --title "$title" --body-file "$tmp"
  fi
}

cmd_import() {
  if network_jobs_want_help "$@"; then
    usage_import
    return 0
  fi

  local input="${1:-}"
  if [[ -z "$input" ]]; then
    usage_import >&2
    return 1
  fi
  shift || true
  local helper="$ROOT/skills/network-jobs-import/helpers/parse-linkedin.sh"
  if [[ ! -x "$helper" ]]; then
    echo "ERROR: missing $helper" >&2
    return 1
  fi
  mkdir -p "$DATA_HOME"
  "$helper" "$input" --out "$DATA_HOME" "$@"
}

cmd_corpus_clear() {
  local wipe_triage=0 yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --triage) wipe_triage=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -h|--help) usage_corpus; return 0 ;;
      *)
        echo "Unknown arg: $1" >&2
        echo "Try: network-jobs corpus clear --help" >&2
        return 1
        ;;
    esac
  done

  local corpus="$DATA_HOME/corpus"
  local triage="$DATA_HOME/triage"

  echo "This will remove:"
  echo "  searchable corpus under $corpus"
  if [[ "$wipe_triage" -eq 1 ]]; then
    echo "  staged triage under $triage/careers-*"
  else
    echo "  (keeping triage/ — pass --triage to wipe staged batches)"
  fi
  echo "  (keeping profile, preferences, resume, connections, companies, config)"
  echo

  if [[ "$yes" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      echo "error: non-interactive shell — pass --yes to confirm" >&2
      return 1
    fi
    printf "Continue? [y/N] "
    local answer
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; return 1 ;;
    esac
  fi

  mkdir -p "$corpus"
  local removed=0 path
  shopt -s nullglob
  for path in "$corpus"/*.json "$corpus"/.work; do
    [[ -e "$path" || -L "$path" ]] || continue
    rm -rf "$path"
    echo "removed $path"
    removed=$((removed + 1))
  done
  shopt -u nullglob

  cat > "$corpus/manifest.json" <<'EOF'
{
  "lastUpdated": null,
  "totalJobs": 0,
  "categories": {}
}
EOF
  echo "wrote $corpus/manifest.json (empty)"

  if [[ "$wipe_triage" -eq 1 ]]; then
    mkdir -p "$triage"
    shopt -s nullglob
    for path in "$triage"/careers-*; do
      rm -rf "$path"
      echo "removed $path"
      removed=$((removed + 1))
    done
    shopt -u nullglob
  fi

  {
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) corpus clear triage=$wipe_triage"
  } >> "$DATA_HOME/logs/setup.log" 2>/dev/null || true

  echo
  echo "Corpus cleared ($removed paths removed)."
  echo "Next: in your agent, run careers-discover, review triage, then confirm ingest."
}

cmd_corpus() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    ""|-h|--help|help) usage_corpus ;;
    clear) cmd_corpus_clear "$@" ;;
    *)
      echo "Unknown corpus command: $sub" >&2
      echo "Try: network-jobs corpus clear --help" >&2
      return 1
      ;;
  esac
}

cmd_profile_import() {
  if network_jobs_want_help "$@"; then
    usage_profile
    return 0
  fi
  local input="${1:-}"
  if [[ -z "$input" ]]; then
    usage_profile >&2
    return 1
  fi
  local helper="$ROOT/skills/network-jobs-setup/helpers/import-resume.sh"
  if [[ ! -x "$helper" ]]; then
    echo "ERROR: missing $helper" >&2
    return 1
  fi
  mkdir -p "$DATA_HOME"
  "$helper" "$input" "$DATA_HOME"
  echo
  echo "Next: in your agent — \"set up network jobs from my resume\""
  echo "  (fills profile, then a prefs interview: location, remote/hybrid,"
  echo "   IC vs manager, former employers include/exclude, …)."
}

cmd_profile_show() {
  if network_jobs_want_help "$@"; then
    usage_profile
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    return 1
  fi
  echo "==> profile ($DATA_HOME/profile.json)"
  if [[ -f "$DATA_HOME/profile.json" ]]; then
    jq . "$DATA_HOME/profile.json"
  else
    echo "(missing)"
  fi
  echo
  echo "==> preferences ($DATA_HOME/preferences.json)"
  if [[ -f "$DATA_HOME/preferences.json" ]]; then
    jq . "$DATA_HOME/preferences.json"
  else
    echo "(missing — run preferences interview in your agent)"
  fi
  echo
  echo "==> resume"
  if [[ -d "$DATA_HOME/resume" ]]; then
    ls -la "$DATA_HOME/resume"
    if [[ -f "$DATA_HOME/resume/text.md" ]]; then
      echo "text.md lines: $(wc -l < "$DATA_HOME/resume/text.md")"
    fi
  else
    echo "(none — network-jobs profile import <file>)"
  fi
}

cmd_profile_clear() {
  local wipe_resume=0 yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --resume) wipe_resume=1; shift ;;
      -y|--yes) yes=1; shift ;;
      -h|--help) usage_profile; return 0 ;;
      *)
        echo "Unknown arg: $1" >&2
        echo "Try: network-jobs profile clear --help" >&2
        return 1
        ;;
    esac
  done

  echo "This will remove:"
  echo "  $DATA_HOME/profile.json (reset to empty stub)"
  echo "  $DATA_HOME/preferences.json"
  if [[ "$wipe_resume" -eq 1 ]]; then
    echo "  $DATA_HOME/resume/"
  else
    echo "  (keeping resume/ — pass --resume to wipe)"
  fi
  echo "  (keeping corpus, connections, companies, config)"
  echo

  if [[ "$yes" -ne 1 ]]; then
    if [[ ! -t 0 ]]; then
      echo "error: non-interactive shell — pass --yes to confirm" >&2
      return 1
    fi
    printf "Continue? [y/N] "
    local answer
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Aborted."; return 1 ;;
    esac
  fi

  mkdir -p "$DATA_HOME"
  cat > "$DATA_HOME/profile.json" <<'EOF'
{
  "name": "",
  "email": "",
  "title": "",
  "company": "",
  "url": ""
}
EOF
  echo "wrote empty $DATA_HOME/profile.json"

  if [[ -e "$DATA_HOME/preferences.json" || -L "$DATA_HOME/preferences.json" ]]; then
    rm -f "$DATA_HOME/preferences.json"
    echo "removed $DATA_HOME/preferences.json"
  fi

  if [[ "$wipe_resume" -eq 1 ]]; then
    if [[ -d "$DATA_HOME/resume" ]]; then
      rm -rf "$DATA_HOME/resume"
      echo "removed $DATA_HOME/resume"
    fi
    mkdir -p "$DATA_HOME/resume"
  fi

  {
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) profile clear resume=$wipe_resume"
  } >> "$DATA_HOME/logs/setup.log" 2>/dev/null || true

  echo
  echo "Profile cleared."
  echo "Next: network-jobs profile import ~/resume.pdf"
  echo "  then in your agent: \"set up network jobs from my resume\""
}

cmd_profile() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    ""|-h|--help|help) usage_profile ;;
    import) cmd_profile_import "$@" ;;
    show) cmd_profile_show "$@" ;;
    clear) cmd_profile_clear "$@" ;;
    *)
      echo "Unknown profile command: $sub" >&2
      echo "Try: network-jobs profile --help" >&2
      return 1
      ;;
  esac
}

