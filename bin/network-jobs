  if network_jobs_want_help "$@"; then
    usage_which
    return 0
  fi
  if [[ $# -gt 0 ]]; then
    echo "Unknown arg: $1" >&2
    echo "Try: network-jobs which --help" >&2
    return 1
  fi
  echo "suite=$ROOT"
  echo "data=$DATA_HOME"
}

# Day-to-day commands delegate to the Python lib CLI (network_jobs.cli).
_lib_cli() {
  PYTHONPATH="$ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m network_jobs.cli "$@"
}

cmd_search() {
  if network_jobs_want_help "$@"; then
    usage_search
    return 0
  fi
  _lib_cli search "$@"
}

cmd_intros() {
  if network_jobs_want_help "$@"; then
    usage_intros
    return 0
  fi
  _lib_cli rank-intros "$@"
}

cmd_demo() {
  if network_jobs_want_help "$@"; then
    usage_demo
    return 0
  fi
  _lib_cli demo "$@"
}

cmd_review_matches() {
  if network_jobs_want_help "$@"; then
    usage_review_matches
    return 0
  fi
  if [[ $# -eq 0 ]]; then
    usage_review_matches >&2
    return 1
  fi
  _lib_cli review-matches "$@"
}

cmd_build_pack() {
  if network_jobs_want_help "$@"; then
    usage_build_pack
    return 0
  fi
  if [[ $# -eq 0 ]]; then
    usage_build_pack >&2
    return 1
  fi
  _lib_cli build-pack "$@"
}

cmd_fetch_pack() {
  if network_jobs_want_help "$@"; then
    usage_fetch_pack
    return 0
  fi
  if [[ $# -eq 0 ]]; then
    usage_fetch_pack >&2
    return 1
  fi
  _lib_cli fetch-pack "$@"
}

cmd_embed_setup() {
  if network_jobs_want_help "$@"; then
    usage_embed_setup
    return 0
  fi
  _lib_cli embed-setup "$@"
}

cmd_companies() {
  if network_jobs_want_help "$@"; then
    usage_companies
    return 0
  fi
  _lib_cli companies "$@"
}

cmd_refresh() {
  if network_jobs_want_help "$@"; then
    usage_refresh
    return 0
  fi
  _lib_cli refresh "$@"
}

case "$cmd" in
  ""|-h|--help) usage ;;
  -V|--version|version) network_jobs_version ;;
  help) cmd_help "$@" ;;
  setup)
    if network_jobs_want_help "$@"; then
      usage_setup
    else
      exec "$ROOT/setup" "$@"
    fi
    ;;
  update) cmd_update "$@" ;;
  doctor) cmd_doctor "$@" ;;
  report) cmd_report "$@" ;;
  import) cmd_import "$@" ;;
  search) cmd_search "$@" ;;
  intros) cmd_intros "$@" ;;
  demo) cmd_demo "$@" ;;
  embed-setup) cmd_embed_setup "$@" ;;
  companies) cmd_companies "$@" ;;
  refresh) cmd_refresh "$@" ;;
  review-matches) cmd_review_matches "$@" ;;
  build-pack) cmd_build_pack "$@" ;;
  fetch-pack) cmd_fetch_pack "$@" ;;
  profile) cmd_profile "$@" ;;
  corpus) cmd_corpus "$@" ;;
  reset) cmd_reset "$@" ;;
  uninstall) cmd_reset --data "$@" ;;
  agents) cmd_agents "$@" ;;
  routing) cmd_routing "$@" ;;
  which) cmd_which "$@" ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Try: network-jobs --help" >&2
    exit 1
    ;;
esac
