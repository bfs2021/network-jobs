#!/usr/bin/env bash
# Network Jobs suite installer.
# Creates ~/.network-jobs and links skills into one or more agent skill dirs.
set -euo pipefail

SUITE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/agents.sh
source "$SUITE_ROOT/lib/agents.sh"
# shellcheck source=lib/browser.sh
source "$SUITE_ROOT/lib/browser.sh"

DATA_HOME="${NETWORK_JOBS_HOME:-$HOME/.network-jobs}"
SKILLS_SRC="$SUITE_ROOT/skills"
SKILLS=("${NETWORK_JOBS_SKILL_IDS[@]}")

AGENTS_CSV=""
COPY_MODE=0
VERBOSE=0
FORCE=0
WITH_BROWSER=1
PRINT_ROUTING=0
INSTALL_LAUNCHER=1

usage() {
  cat <<'EOF'
Usage: network-jobs setup [options]

Create ~/.network-jobs and link skills into one or more agent skill directories.

Options:
  --agent <list>    Target agents: auto (default), all, or claude-code,cursor,…
  --force           Replace existing non-symlink skill dirs (e.g. older installs)
  --copy            Copy skills instead of symlinking
  --no-browser      Skip installing agent-browser when missing
  --with-browser    Install agent-browser if missing (default)
  --no-launcher     Skip installing the network-jobs launcher on PATH
  --print-routing   Print the AGENTS.md routing snippet when finished
  --verbose, -v     Show every path as it is linked
  --help, -h        Show this help

Env:
  NETWORK_JOBS_HOME        Data directory (default: ~/.network-jobs)
  NETWORK_JOBS_SKILLS_DIR  Single skills parent (overrides --agent)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --agent|--agents) AGENTS_CSV="$2"; shift 2 ;;
    --copy) COPY_MODE=1; shift ;;
    --force) FORCE=1; shift ;;
    --with-browser) WITH_BROWSER=1; shift ;;
    --no-browser) WITH_BROWSER=0; shift ;;
    --no-launcher) INSTALL_LAUNCHER=0; shift ;;
    --print-routing) PRINT_ROUTING=1; shift ;;
    -v|--verbose) VERBOSE=1; shift ;;
    -y|--yes) shift ;;
    *) echo "Unknown arg: $1" >&2; usage; exit 1 ;;
  esac
done

say() { [[ "$VERBOSE" -eq 1 ]] && echo "$@"; return 0; }

# --- dependency checks ---
missing=()
for cmd in curl jq unzip python3; do
  command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
done
if ((${#missing[@]})); then
  echo "error: missing required tools: ${missing[*]}" >&2
  exit 1
fi

# --- npm resolution -------------------------------------------------------
# `npm` is often a version-manager shim (mise/asdf) that fails when no global
# runtime is selected, so fall back to a real npm inside an installed runtime.
resolve_npm() {
  if command -v npm >/dev/null 2>&1 && npm --version >/dev/null 2>&1; then
    command -v npm
    return 0
  fi
  local -a candidates=()
  local pattern cand
  for pattern in \
    "$HOME/.local/share/mise/installs/node/"*/bin/npm \
    "$HOME/.asdf/installs/nodejs/"*/bin/npm \
    "$HOME/.nvm/versions/node/"*/bin/npm \
    /usr/local/bin/npm /usr/bin/npm
  do
    [[ -x "$pattern" ]] && candidates+=("$pattern")
  done
  if ((${#candidates[@]})); then
    for cand in $(printf '%s\n' "${candidates[@]}" | sort -V -r); do
      if "$cand" --version >/dev/null 2>&1; then
        echo "$cand"
        return 0
      fi
    done
  fi
  return 1
}

# Make freshly installed global bins visible to this process.
refresh_tool_path() {
  local npm_bin="$1" prefix
  if command -v mise >/dev/null 2>&1; then
    mise reshim >/dev/null 2>&1 || true
  fi
  prefix="$("$npm_bin" prefix -g 2>/dev/null || true)"
  if [[ -n "$prefix" && -d "$prefix/bin" ]]; then
    case ":$PATH:" in
      *":$prefix/bin:"*) ;;
      *) PATH="$prefix/bin:$PATH"; export PATH ;;
    esac
  fi
  hash -r 2>/dev/null || true
}

# --- browser automation (default on; needed for JS-heavy career pages) ---
# Presence is not enough: compare against agentBrowser.minVersion and upgrade
# only when below the floor (never just because a newer build exists).
# Pin the install/upgrade spec to that floor from package.json — one source
# of truth, not a second hardcoded version and not @latest. Read once.
browser_note=""
ab_min="$(ab_min_version "$SUITE_ROOT/package.json" || true)"
if [[ -n "$ab_min" ]]; then
  ab_spec="agent-browser@${ab_min}"
else
  # Don't invent a version. Install untagged, but say so — the floor check
  # is a no-op when minVersion is missing.
  ab_spec="agent-browser"
fi
if command -v agent-browser >/dev/null 2>&1; then
  ab_have="$(ab_installed_version || true)"
  ab_desc="$(ab_describe_version "$ab_have" "$ab_min")"
  if [[ "$ab_desc" == *" < "* ]]; then
    if [[ "$WITH_BROWSER" -eq 1 ]] && NPM_BIN="$(resolve_npm)"; then
      echo "Upgrading agent-browser $ab_have → $ab_min (below the supported floor)…"
      if "$NPM_BIN" install -g "$ab_spec" >/dev/null 2>&1; then
        refresh_tool_path "$NPM_BIN"
        ab_new="$(ab_installed_version || true)"
        ab_desc="$(ab_describe_version "$ab_new" "$ab_min")"
        if [[ "$ab_desc" == *" < "* || "$ab_desc" == "unknown" ]]; then
          browser_note="agent-browser $ab_desc — upgrade did not reach the floor (run: $NPM_BIN i -g $ab_spec)"
        else
          browser_note="agent-browser $ab_desc (upgraded from $ab_have)"
        fi
      else
        browser_note="agent-browser $ab_desc — upgrade failed (run: $NPM_BIN i -g $ab_spec)"
      fi
    else
      browser_note="agent-browser $ab_desc — run: network-jobs update"
    fi
  else
    if [[ -z "$ab_min" ]]; then
      browser_note="agent-browser ${ab_desc} — package.json has no agentBrowser.minVersion; floor not checked"
    else
      browser_note="agent-browser ${ab_desc}"
    fi
  fi
elif [[ "$WITH_BROWSER" -eq 1 ]]; then
  if NPM_BIN="$(resolve_npm)"; then
    echo "Installing agent-browser…"
    if "$NPM_BIN" install -g "$ab_spec" >/dev/null 2>&1; then
      refresh_tool_path "$NPM_BIN"
      if command -v agent-browser >/dev/null 2>&1; then
        # Verify what actually landed: a stale registry mirror or proxy can
        # serve a build below the floor, and "installed" would then be a lie.
        ab_new="$(ab_installed_version || true)"
        ab_desc="$(ab_describe_version "$ab_new" "$ab_min")"
        case "$ab_desc" in
          *" < "*) browser_note="agent-browser $ab_desc — installed but below the floor (run: $NPM_BIN i -g $ab_spec)" ;;
          unknown) browser_note="agent-browser installed (version unknown)" ;;
          *) browser_note="agent-browser $ab_desc installed" ;;
        esac
        if [[ -z "$ab_min" ]]; then
          browser_note="${browser_note} — package.json has no agentBrowser.minVersion; installed unpinned, floor not checked"
        fi
      else
        npm_prefix="$("$NPM_BIN" prefix -g 2>/dev/null || true)"
        browser_note="agent-browser installed to ${npm_prefix:-npm global}/bin (add it to PATH)"
      fi
    else
      browser_note="agent-browser install failed (run: $NPM_BIN i -g $ab_spec)"
    fi
  else
    browser_note="no usable npm found — install node, then: npm i -g $ab_spec"
  fi
else
  browser_note="agent-browser skipped (--no-browser)"
fi

# --- data dirs ---
seeded=0
mkdir -p \
  "$DATA_HOME/connections" \
  "$DATA_HOME/companies" \
  "$DATA_HOME/config" \
  "$DATA_HOME/triage" \
  "$DATA_HOME/corpus" \
  "$DATA_HOME/resume" \
  "$DATA_HOME/logs"

# Remember an explicit --no-browser so doctor doesn't nag about it later.
if [[ "$WITH_BROWSER" -eq 0 ]]; then
  touch "$DATA_HOME/config/no-browser"
else
  rm -f "$DATA_HOME/config/no-browser"
fi

ASSET_DIR="$SKILLS_SRC/network-jobs-import/assets"
for f in companies-to-ignore.json company-words-to-ignore.json company-overrides.json; do
  if [[ ! -f "$DATA_HOME/config/$f" && -f "$ASSET_DIR/$f" ]]; then
    cp "$ASSET_DIR/$f" "$DATA_HOME/config/$f"
    seeded=$((seeded + 1))
    say "seeded config/$f"
  fi
done

profile_new=0
if [[ ! -f "$DATA_HOME/profile.json" ]]; then
  cat > "$DATA_HOME/profile.json" <<'EOF'
{
  "name": "",
  "email": "",
  "title": "",
  "company": "",
  "url": ""
}
EOF
  profile_new=1
fi

if [[ ! -f "$DATA_HOME/corpus/manifest.json" ]]; then
  cat > "$DATA_HOME/corpus/manifest.json" <<'EOF'
{
  "lastUpdated": null,
  "totalJobs": 0,
  "categories": {}
}
EOF
fi

echo "$SUITE_ROOT" > "$DATA_HOME/suite-root"
export NETWORK_JOBS_SUITE="$SUITE_ROOT"
if [[ -f "$SUITE_ROOT/package.json" ]] && command -v jq >/dev/null 2>&1; then
  jq -r '.version // "0.0.0"' "$SUITE_ROOT/package.json" > "$DATA_HOME/version"
fi

# --- CLI launcher ---------------------------------------------------------
# npx installs leave no `network-jobs` on PATH, so drop in a small launcher.
# It resolves the suite recorded in suite-root and falls back to npx, which
# keeps working even after an npx store path is garbage collected.
launcher_note=""
if [[ "$INSTALL_LAUNCHER" -eq 1 ]]; then
  launcher_dir=""
  for candidate in "$HOME/.local/bin" "$HOME/bin"; do
    case ":$PATH:" in
      *":$candidate:"*) launcher_dir="$candidate"; break ;;
    esac
  done
  [[ -z "$launcher_dir" ]] && launcher_dir="$HOME/.local/bin"

  # A package runner (pnpm dlx / npx) prepends its own temporary node_modules/.bin
  # to PATH, so `command -v` finds a network-jobs that vanishes when we exit.
  # Only a copy outside those caches counts as already installed.
  cli_is_ephemeral() {
    local found="$1" real
    real="$(readlink -f "$found" 2>/dev/null || echo "$found")"
    case "$found$real" in
      *"/.cache/pnpm/dlx/"*|*"/.npm/_npx/"*|*"/pnpm/store/"*) return 0 ;;
    esac
    [[ "$real" == "$SUITE_ROOT/bin/network-jobs" ]] && return 0
    return 1
  }

  existing_cli="$(command -v network-jobs 2>/dev/null || true)"
  if [[ -n "$existing_cli" ]] && cli_is_ephemeral "$existing_cli"; then
    existing_cli=""
  fi

  if [[ -n "$existing_cli" && ! -e "$launcher_dir/network-jobs" ]]; then
    launcher_note="network-jobs already on PATH ($existing_cli)"
  else
    mkdir -p "$launcher_dir"
    cat > "$launcher_dir/network-jobs" <<'LAUNCHER'
#!/usr/bin/env bash
# network-jobs launcher — resolves the installed suite, falls back to a
# fresh fetch from GitHub if that copy was garbage collected.
set -euo pipefail
data="${NETWORK_JOBS_HOME:-$HOME/.network-jobs}"
root="$(cat "$data/suite-root" 2>/dev/null || true)"
if [[ -n "$root" && -x "$root/bin/network-jobs" ]]; then
  exec "$root/bin/network-jobs" "$@"
fi
if command -v pnpm >/dev/null 2>&1 && pnpm --version >/dev/null 2>&1; then
  exec pnpm dlx '@hirefrank/network-jobs@latest' "$@"
fi
if command -v npx >/dev/null 2>&1 && npx --version >/dev/null 2>&1; then
  exec npx --yes '@hirefrank/network-jobs@latest' "$@"
fi
echo "network-jobs: suite not found and no pnpm/npx available" >&2
exit 1
LAUNCHER
    chmod +x "$launcher_dir/network-jobs"
    hash -r 2>/dev/null || true
    case ":$PATH:" in
      *":$launcher_dir:"*) launcher_note="network-jobs → $launcher_dir/network-jobs" ;;
      *) launcher_note="network-jobs → $launcher_dir/network-jobs (add $launcher_dir to PATH)" ;;
    esac
  fi
else
  launcher_note="launcher skipped (--no-launcher)"
fi

# --- resolve target skill parents ---
declare -a TARGET_DIRS=()
declare -a TARGET_LABELS=()

if [[ -n "${NETWORK_JOBS_SKILLS_DIR:-}" ]]; then
  TARGET_DIRS+=("$NETWORK_JOBS_SKILLS_DIR")
  TARGET_LABELS+=("custom")
else
  AGENTS_CSV="${AGENTS_CSV:-auto}"
  declare -a agent_names=()
  case "$AGENTS_CSV" in
    all) agent_names=("${NETWORK_JOBS_AGENT_IDS[@]}") ;;
    auto)
      while IFS= read -r name; do
        [[ -n "$name" ]] && agent_names+=("$name")
      done < <(network_jobs_detect_agents)
      ;;
    *) IFS=',' read -ra agent_names <<<"$AGENTS_CSV" ;;
  esac

  for name in "${agent_names[@]}"; do
    name="$(echo "$name" | xargs)"
    [[ -z "$name" ]] && continue
    dir="$(network_jobs_agent_dir "$name" || true)"
    if [[ -z "$dir" ]]; then
      echo "warning: unknown agent '$name' — skipped" >&2
      continue
    fi
    TARGET_DIRS+=("$dir")
    TARGET_LABELS+=("$name")
  done
fi

if ((${#TARGET_DIRS[@]} == 0)); then
  echo "error: no agent skill directories selected" >&2
  exit 1
fi

# install_skill: returns 0 linked, 2 skipped
install_skill() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"

  if [[ -L "$dest" ]]; then
    rm -f "$dest"
  elif [[ -e "$dest" ]]; then
    if [[ "$(cd "$dest" 2>/dev/null && pwd)" == "$(cd "$src" && pwd)" ]]; then
      say "ok      $dest (already installed)"
      return 0
    fi
    if [[ "$FORCE" -eq 1 ]]; then
      rm -rf "$dest"
    else
      say "skip    $dest (existing directory; use --force to replace)"
      return 2
    fi
  fi

  if [[ "$COPY_MODE" -eq 1 ]]; then
    rm -rf "$dest"
    cp -R "$src" "$dest"
    say "copied  $dest"
  else
    ln -sfn "$src" "$dest"
    say "linked  $dest -> $src"
  fi
  return 0
}

declare -a AGENT_SUMMARY=()
declare -a SKIPPED=()

for i in "${!TARGET_DIRS[@]}"; do
  parent="${TARGET_DIRS[$i]}"
  label="${TARGET_LABELS[$i]}"

  if [[ "$(basename "$parent")" == "network-jobs" ]]; then
    echo "error: skills parent must not be named network-jobs: $parent" >&2
    exit 1
  fi

  mkdir -p "$parent"
  say "-- $label ($parent)"

  linked=0
  skipped=0
  for skill in "${SKILLS[@]}"; do
    src="$SKILLS_SRC/$skill"
    [[ -d "$src" ]] || continue
    if install_skill "$src" "$parent/$skill"; then
      linked=$((linked + 1))
    else
      skipped=$((skipped + 1))
      SKIPPED+=("$parent/$skill")
    fi
  done

  if ((skipped > 0)); then
    AGENT_SUMMARY+=("$label ($linked/${#SKILLS[@]})")
  else
    AGENT_SUMMARY+=("$label")
  fi
done

{
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) setup suite=$SUITE_ROOT data=$DATA_HOME agents=${TARGET_LABELS[*]}"
} >> "$DATA_HOME/logs/setup.log"

# --- summary ---
agents_joined=""
for entry in "${AGENT_SUMMARY[@]}"; do
  agents_joined+="${agents_joined:+, }$entry"
done

echo "Network Jobs installed"
echo "  data     $DATA_HOME$([[ $seeded -gt 0 ]] && echo " (seeded)")"
echo "  skills   ${#SKILLS[@]} → $agents_joined"
echo "  browser  $browser_note"
echo "  cli      $launcher_note"
if [[ -f "$DATA_HOME/version" ]]; then
  echo "  version  $(cat "$DATA_HOME/version")"
elif [[ -f "$SUITE_ROOT/package.json" ]] && command -v jq >/dev/null 2>&1; then
  echo "  version  $(jq -r '.version // "?"' "$SUITE_ROOT/package.json")"
fi

if ((${#SKIPPED[@]} > 0)); then
  echo
  echo "  ${#SKIPPED[@]} existing skill dir(s) left untouched (older installs)."
  echo "  Replace them with: setup --force$([[ $VERBOSE -eq 0 ]] && echo "   (see --verbose for paths)")"
fi

echo
echo "Next:"
step=1
if command -v network-jobs >/dev/null 2>&1; then
  cli_invocation="network-jobs"
else
  cli_invocation="npx --yes @hirefrank/network-jobs@latest"
fi

has_resume=0
if [[ -f "$DATA_HOME/resume/text.md" ]] || compgen -G "$DATA_HOME/resume/source.*" >/dev/null 2>&1; then
  has_resume=1
fi
profile_name=""
profile_email=""
if [[ -f "$DATA_HOME/profile.json" ]]; then
  profile_name="$(jq -r '.name // empty' "$DATA_HOME/profile.json" 2>/dev/null || true)"
  profile_email="$(jq -r '.email // empty' "$DATA_HOME/profile.json" 2>/dev/null || true)"
fi
prefs_done=false
if [[ -f "$DATA_HOME/preferences.json" ]]; then
  prefs_done="$(jq -r '.interviewComplete // false' "$DATA_HOME/preferences.json" 2>/dev/null || echo false)"
fi
has_companies=0
if [[ -f "$DATA_HOME/companies/companies.json" ]]; then
  company_count="$(jq 'length' "$DATA_HOME/companies/companies.json" 2>/dev/null || echo 0)"
  [[ "$company_count" != "0" && "$company_count" != "null" ]] && has_companies=1
fi

if [[ "$has_resume" -eq 0 ]]; then
  echo "  $((step++)). $cli_invocation profile import ~/path/to/resume.pdf"
fi
if [[ -z "$profile_name" || -z "$profile_email" || "$prefs_done" != "true" ]]; then
  echo "  $((step++)). In your agent: \"set up network jobs from my resume\" (profile + prefs interview)"
fi
if [[ "$has_companies" -eq 0 ]]; then
  echo "  $((step++)). $cli_invocation import ~/Downloads/Connections.zip"
fi
echo "  $((step++)). In your agent: \"find open roles at companies I know\" (review triage before ingest)"

if [[ "$PRINT_ROUTING" -eq 1 && -f "$SUITE_ROOT/docs/AGENTS.md.snippet" ]]; then
  echo
  cat "$SUITE_ROOT/docs/AGENTS.md.snippet"
fi

